{
  "name": "iobroker.scheduler",
  "version": "2.0.0",
  "description": "This adapter allows to communicate Amazon Alexa and Google Home with ioBroker.",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "homepage": "https://github.com/ioBroker/ioBroker.scheduler",
  "keywords": [
    "ioBroker",
    "mqtt",
    "aws",
    "cloud",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.scheduler"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^3.0.0",
    "@iobroker/types": "^7.2.2",
    "@iobroker/vis-2-widgets-react-dev": "^4.0.4",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.scheduler/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "img/",
    "io-package.json",
    "widgets/",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha --exit",
    "test:package": "mocha test/testPackageFiles.js --exit",
    "test:integration": "mocha test/testAdapter.js --exit",
    "prepare": "tsx tasks.ts --backend-build",
    "prepublishOnly": "tsx tasks.ts",
    "build": "tsx tasks.ts",
    "build-backend": "tsx tasks.ts --backend-build",
    "build-admin": "tsx tasks.ts --admin-build",
    "build-widgets": "tsx tasks.ts --widget-build",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy",
    "4-patch": "tsx tasks.ts --4-patch",
    "0-widget-clean": "tsx tasks.ts --0-widget-clean",
    "1-widget-npm": "tsx tasks.ts --1-widget-npm",
    "2-widget-compile": "tsx tasks.ts --2-widget-compile",
    "3-widget-copy": "tsx tasks.ts --3-widget-copy",
    "check:ts": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade && cd ../src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-widgets && npm i -f && cd ../src-admin && npm i -f && cd"
  },
  "license": "MIT",
  "readmeFilename": "README.md"
}
